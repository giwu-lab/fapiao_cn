__pycache__/
*.py[cod]
*.egg-info/
*.so

# tests + samples 都不进镜像（运行时用不到）
tests/
samples/

# 构建产物
dist/
build/
.eggs/
*.tar.gz

# 企业版源码（ee/）不进构建上下文：企业版 wheel 由宿主侧的
# scripts/build_ee_wheel.py 预先构建到 wheels/，镜像只从 wheels 安装。
# 这样连"构建上下文"里都没有企业版源码 —— 开源版的产物边界更干净。
ee/

# 虚拟环境（本地开发产物，体积大且与镜像无关）
# 注意：.gitignore 里也有这几条 —— 两边必须同步，否则 `pip install -e .`
# 之后本地的 .venv/ 会整个进构建上下文（>200 MB）。
.venv/
venv/
env/

# 本地密钥文件（操作者自建的 API key 存储；与 .env 同等对待）
keys.json

# 注：wheels/ 不忽略 —— Dockerfile 第 11 行的 `COPY wheels /wheels` 需要它
# （wheels/.gitkeep 是受版本控制的占位文件，保证全新克隆里这个 COPY 也成立）。
# wheels/ 里没有 .whl 时，Dockerfile 会自动回退到构建期在线下载依赖。

# 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# git
.git/
.gitignore
.gitattributes

# 日志 / PID
logs/*.log
logs/*.pid
*.pid
logs/fapiao_cn.pid

# 文档 / CI
CHANGELOG.md
Dockerfile
docker-compose.yml
.dockerignore
.env*
.github/