# fapiao_cn 环境变量示例 — 拷贝到 .env 后按需修改

# 服务监听
FC_HOST=0.0.0.0
FC_PORT=8091

# 国税查验代理（默认关闭；启用时设置 VERIFY_ENDPOINT）
FC_VERIFY_ENABLED=false
FC_VERIFY_ENDPOINT=
FC_VERIFY_API_KEY=
FC_VERIFY_TIMEOUT=15

# 性能
FC_CACHE_SIZE=128       # LRU 缓存条目数；0 关闭
FC_BATCH_WORKERS=4      # batch 并行 worker 数

# 文件大小限制
# FC_MAX_FILE_MB 同时作用于 /extract 与 /extract/batch（同一份文件走哪个入口
# 都按这一个上限判定）。默认 10 MB；需要放行更大的文件再显式调大。
FC_MAX_FILE_MB=10
FC_MAX_BATCH_FILES=50
FC_MAX_BATCH_TOTAL_MB=500
# 注：旧的 FC_MAX_BATCH_SINGLE_MB 已移除——单文件上限统一到
# FC_MAX_FILE_MB。环境变量里残留的旧值会被静默忽略，可以直接删掉。

# 消费类别分类（/extract 响应里的 expense_category / _label / _source）
# false 时三个字段恒为空字符串，不消耗额外计算。
FC_EXPENSE_CATEGORY_ENABLED=true

# API 鉴权
# 默认开启。两值都空时启动 WARN 且所有端点公开（dev 友好）；建议生产
# 部署前显式设置其中之一。
FC_API_AUTH_ENABLED=true

# 简单模式：逗号分隔多把 key；所有 key 拥有 extract/verify/admin 全域权限。
# 推荐用于内网少量调用方；多租户请改用 JSON 文件模式。
FC_API_KEYS=

# 结构化模式：JSON 文件路径；可配 label/scopes/rpm/burst。
# 文件格式见 README「API 鉴权」章节。
# 优先级：FC_API_KEYS 非空时**忽略**本变量（simple 模式生效）；
#          本变量非空时读 JSON 文件，文件坏则启动失败（H2 fail-fast）。
FC_API_KEYS_FILE=

# 限速默认（JSON 模式未指定 rpm/burst 时使用；simple mode 也使用）
FC_API_KEY_DEFAULT_RPM=60
FC_API_KEY_DEFAULT_BURST=10

# 双轨兼容：true 时未带 token 的旧调用方也放行（仅在 key 已配置时生效）。
# 仅用于迁移窗口期，建议关闭。
FC_API_LEGACY_ALLOW=false

# H1 LFI 防护：file_path 输入白名单（CSV 目录列表）。
# 留空时 file_path 输入被完全拒绝——所有调用方只能上传文件或传 base64。
# 多目录用逗号分隔，例如：
#   FC_ALLOWED_FILE_PATHS=/srv/inbox,/tmp/upload
# 路径会被 resolve() 绝对化，符号链接与 ../ 都会被拦截。
FC_ALLOWED_FILE_PATHS=

# 应用根目录（/health/full 用）。
# 留空时按源码布局从 src/fapiao_cn/server.py 向上两级推导为仓库根，
# 适合 dev / CI。wheel 安装（Docker 镜像）后 __file__ 落在 site-packages，
# 无法再向上定位，此时由镜像内置 FC_APP_ROOT=/app 指向日志卷挂载点。
# 本地一般无需设置。
# FC_APP_ROOT=

# 企业版许可证（仅在装了 fapiao_cn_ee 时有意义）
# 指向一份 Ed25519 签名的 JSON 许可证；缺失 / 过期 / 签名不合法时服务自动
# 降级成开源版行为（不拒绝启动）。签发手册见企业版私有仓库的 AUTHORIZATION.md。
# FC_LICENSE_FILE=/app/license.json

# ⚠️ 关于仓库根目录的 keys.json / .env：
#   - 两者已被 .gitignore 排除，不会进入版本库；
#   - 但本地副本仍可能包含**真实外观的 dev/test key**，请勿在生产复用；
#   - 生产部署请使用 secret manager / K8s Secret / Vault 注入，
#     **不要**把 keys.json 复制到镜像内。
#   - 共享 / 备份工作目录前请先执行 ``chmod 600 keys.json`` 或直接删除。
